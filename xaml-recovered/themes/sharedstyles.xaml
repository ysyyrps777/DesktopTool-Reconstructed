<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="PanelActionButton" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource Sb_99_000000}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ZoneButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource Sb_1A_FFFFFF}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" MinHeight="{TemplateBinding FrameworkElement.MinHeight}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Sb_33_FFFFFF}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NarrowScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource Sb_44_FFFFFF}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" Width="{TemplateBinding FrameworkElement.Width}">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border CornerRadius="3" Margin="1,0" Background="{StaticResource Sb_55_FFFFFF}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{StaticResource Sb_44_FFFFFF}" />
                            <Style.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Sb_77_FFFFFF}" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="#FFF3F3F3" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Sb_33_FFFFFF}" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter Property="Background" Value="#FF4A90D9" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="#FF2B2B2B" />
    <Setter Property="Foreground" Value="#FFF3F3F3" />
    <Setter Property="BorderBrush" Value="#FF3B3B3B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid Name="templateRoot" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Name="MainBorder" Grid.Column="0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
              <ContentPresenter Name="ContentPresenter" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="2,0,0,0" />
            </Border>
            <ToggleButton Name="ToggleButton" Grid.Column="0" Grid.ColumnSpan="2" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Path Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.4" Fill="#00FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,4,0" />
            </ToggleButton>
            <Popup Name="PART_Popup" Grid.ColumnSpan="2" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide" Focusable="False" AllowsTransparency="True" MaxHeight="220">
              <Border Background="#FF2B2B2B" BorderBrush="#FF3B3B3B" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}">
                <ScrollViewer Padding="2" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="MainBorder" Property="Border.BorderBrush" Value="{StaticResource Sb_77_FFFFFF}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkRadioButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Name="Outer" Width="16" Height="16" StrokeThickness="1" Fill="{StaticResource Sb_1A_FFFFFF}" Stroke="{StaticResource Sb_55_FFFFFF}" />
              <Ellipse Name="Dot" Width="8" Height="8" Fill="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Outer" Property="Shape.Stroke" Value="{StaticResource Sb_77_FFFFFF}" />
              <Setter TargetName="Outer" Property="Shape.Fill" Value="{StaticResource Sb_33_FFFFFF}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Outer" Property="Shape.Fill" Value="#FF4A90D9" />
              <Setter TargetName="Outer" Property="Shape.Stroke" Value="#FF4A90D9" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkTabRadioStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Bd" BorderThickness="1" CornerRadius="6" Padding="8,8" Background="{StaticResource Sb_1A_FFFFFF}" BorderBrush="{StaticResource Sb_44_FFFFFF}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Sb_33_FFFFFF}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="#FF4A90D9" />
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="#FF4A90D9" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="#FF2B2B2B" />
    <Setter Property="Foreground" Value="#FFF3F3F3" />
    <Setter Property="BorderBrush" Value="#FF3B3B3B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
  </Style>
  <Style x:Key="DarkListBoxItemStretchStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <ContentPresenter HorizontalAlignment="Stretch" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkCheckBoxStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Border Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center" Background="{StaticResource Sb_1A_FFFFFF}" BorderBrush="{StaticResource Sb_55_FFFFFF}">
              <Path Name="Check" Data="M3.2,8.2 L6.4,11.2 L12.4,4.6" Stroke="#FFFFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Border.BorderBrush" Value="{StaticResource Sb_77_FFFFFF}" />
              <Setter TargetName="Box" Property="Border.Background" Value="{StaticResource Sb_33_FFFFFF}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Box" Property="Border.Background" Value="#FF4A90D9" />
              <Setter TargetName="Box" Property="Border.BorderBrush" Value="#FF4A90D9" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Sb_33_FFFFFF}" />
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Sb_88_4A90D9}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DarkCalendarStyle" TargetType="{x:Type Calendar}" BasedOn="{StaticResource {x:Type Calendar}}">
    <Setter Property="Background" Value="#FF2B2B2B" />
    <Setter Property="Foreground" Value="#FFF3F3F3" />
    <Setter Property="BorderBrush" Value="#FF3B3B3B" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Resources>
      <ResourceDictionary>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A8A8A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4A90D9" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A6FB0" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="DarkDatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource {x:Type DatePicker}}">
    <Setter Property="Background" Value="#FF2B2B2B" />
    <Setter Property="Foreground" Value="#FFF3F3F3" />
    <Setter Property="BorderBrush" Value="#FF3B3B3B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="DatePicker.CalendarStyle" Value="{StaticResource DarkCalendarStyle}" />
    <Style.Resources>
      <ResourceDictionary>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A8A8A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4A90D9" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A6FB0" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
</ResourceDictionary>