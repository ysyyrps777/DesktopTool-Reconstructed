<Window x:Class="DesktopTool.Views.DatePickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Title="选择日期" Topmost="False" Focusable="True" xmlns:views="clr-namespace:DesktopTool.Views;assembly=DesktopTool">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PickerCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#44FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#66FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#FF303038" BorderBrush="#FF555565" BorderThickness="1" CornerRadius="8" Padding="4,2,4,6" ClipToBounds="True">
    <StackPanel>
      <Border Height="36" Background="#33FFFFFF" CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="#66FFFFFF" FontSize="16" VerticalAlignment="Center" Margin="6,0,2,0" Cursor="SizeAll" />
          <TextBlock Grid.Column="1" Text="📅 选择日期" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,10,0" />
          <Button Grid.Column="2" Content="✕" Style="{StaticResource PickerCloseButton}" Margin="0,0,6,0" Click="CloseButton_Click" />
        </Grid>
      </Border>
      <Calendar Name="CalendarControl" DisplayMode="Month" Margin="0" Padding="8,4,8,4" Background="#00FFFFFF" Foreground="#FFFFFFFF" SelectedDatesChanged="Calendar_SelectedDatesChanged" />
    </StackPanel>
  </Border>
</Window>