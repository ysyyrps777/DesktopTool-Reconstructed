<Window x:Class="DesktopTool.Views.DesktopSearchWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="桌面搜索" Width="252" Height="52" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual" xmlns:views="clr-namespace:DesktopTool.Views;assembly=DesktopTool">
  <Border Name="RootBorder" Background="#00FFFFFF" CornerRadius="26" PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown" PreviewMouseMove="RootBorder_PreviewMouseMove" PreviewMouseLeftButtonUp="RootBorder_PreviewMouseLeftButtonUp">
    <Grid>
      <Border Name="BgLayer" CornerRadius="26" BorderBrush="#66FFFFFF" BorderThickness="1.5" Background="{Binding PanelColorBrush}" Opacity="{Binding BackgroundOpacity}" />
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Name="DragGrip" Grid.Column="0" Width="20" Cursor="SizeAll" Background="#00FFFFFF" IsHitTestVisible="False">
          <TextBlock Text="⋮⋮" Foreground="#FFFFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Button Name="SearchButton" Grid.Column="1" Width="32" Height="32" Margin="2,0,6,0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="搜索" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FocusVisualStyle="{x:Null}" Click="SearchButton_Click">
          <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="13" Height="13" Stroke="#FFFFFFFF" StrokeThickness="2" Fill="#00FFFFFF" />
            <Line X1="11" Y1="11" X2="18" Y2="18" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeEndLineCap="Round" />
          </Canvas>
        </Button>
        <Grid Column="2">
          <TextBox Name="SearchTextBox" Background="#00FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="14" VerticalContentAlignment="Center" Padding="2,0" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" GotFocus="SearchTextBox_GotFocus" LostKeyboardFocus="SearchTextBox_LostKeyboardFocus" />
          <TextBlock Name="Placeholder" Text="全盘搜索" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False" Visibility="Visible" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>