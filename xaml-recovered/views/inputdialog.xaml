<Window x:Class="DesktopTool.Views.InputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Width="360" Height="185" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FF2E3238" WindowStyle="None" AllowsTransparency="True" xmlns:views="clr-namespace:DesktopTool.Views;assembly=DesktopTool" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border BorderBrush="#FF4A5568" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#FF252930">
        <TextBlock Name="TitleText" Text="输入" Foreground="#FFE0E0E0" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Content="✕" FontSize="12" Foreground="#FFF5F5F5" Background="#FFC0392B" Width="28" Height="24" HorizontalAlignment="Right" Margin="0,0,8,0" Cursor="Hand" Padding="0" BorderThickness="0" Click="Cancel_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="24,10,24,6">
        <TextBlock Name="PromptText" Text="请输入：" Foreground="#FFD0D0D0" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,6" />
        <TextBox Name="InputTextBox" Background="#22FFFFFF" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" BorderThickness="0" FontSize="13" Padding="10,7" VerticalContentAlignment="Center" KeyDown="InputTextBox_KeyDown">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                <Setter Property="Border.CornerRadius" Value="6" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </TextBox>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,6,0,14" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="确定" Width="70" Height="30" FontSize="12" Foreground="#FFFFFFFF" Background="#FF4A90D9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="OK_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="16,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button Content="取消" Width="70" Height="30" FontSize="12" Foreground="#FFFFFFFF" Background="#FF666666" BorderThickness="0" Cursor="Hand" Click="Cancel_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="16,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>