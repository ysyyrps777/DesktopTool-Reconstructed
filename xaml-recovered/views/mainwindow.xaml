<Window x:Class="DesktopTool.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:DesktopTool.Converters" Title="桌面工具箱" Width="700" Height="550" MinWidth="580" MinHeight="440" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" xmlns:views="clr-namespace:DesktopTool.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:InverseBoolConverter x:Key="InverseBool" />
      <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibility" />
      <converters:StringIsEmptyToVisibilityConverter x:Key="StringIsEmptyToVisibility" />
      <converters:StringIsNotEmptyToVisibilityConverter x:Key="StringIsNotEmptyToVisibility" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1A86DB" />
      <SolidColorBrush x:Key="AccentLightBrush" Color="#330078D4" />
      <SolidColorBrush x:Key="BgPrimaryBrush" Color="#FF202020" />
      <SolidColorBrush x:Key="BgSecondaryBrush" Color="#FF1C1C1C" />
      <SolidColorBrush x:Key="BgTertiaryBrush" Color="#FF2B2B2B" />
      <SolidColorBrush x:Key="BgHoverBrush" Color="#FF373737" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FF3F3F46" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC8C8C8" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9A9A" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFE0556A" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFF06B7E" />
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid>
                <Track Name="PART_Track" IsDirectionReversed="true">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="#00FFFFFF" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="#00FFFFFF" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Cursor="Hand">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border Name="thumb" Background="#44FFFFFF" CornerRadius="4" Margin="0,2" Width="6" HorizontalAlignment="Center" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="thumb" Property="Border.Background" Value="#77FFFFFF" />
                              <Setter TargetName="thumb" Property="Width" Value="8" />
                            </Trigger>
                            <Trigger Property="Thumb.IsDragging" Value="True">
                              <Setter TargetName="thumb" Property="Border.Background" Value="#99FFFFFF" />
                              <Setter TargetName="thumb" Property="Width" Value="8" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="WindowBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="SidebarButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="8" Margin="8,1,8,1" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="{StaticResource BgHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SidebarButtonActive" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" CornerRadius="8" Margin="8,1,8,1" Padding="16,0,12,0" Background="{StaticResource BgHoverBrush}">
                <Grid>
                  <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="3" RadiusX="2" RadiusY="2" Margin="-14,6,-16,6" Fill="{StaticResource AccentBrush}" />
                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" CornerRadius="8" Padding="20,0" Background="{StaticResource AccentBrush}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="border" Property="Border.Background" Value="#FF333333" />
                  <Setter Property="Foreground" Value="#FF9A9A9A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="8" Margin="8,1,8,1" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#28E0556A" />
                  <Setter Property="Foreground" Value="{StaticResource DangerHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AccentFillButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="10,0">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DangerFillButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#E54848" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="10,0">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#F05555" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#C93A3A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Background="#00FFFFFF">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Name="switchTrack" Width="44" Height="24" CornerRadius="12" Background="#FF3A3A3A" Margin="0,0,10,0" />
                <Border Name="switchThumb" Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="switchTrack" Property="Border.Background" Value="#FF0078D4" />
                  <Setter TargetName="switchThumb" Property="Border.Background" Value="#FFFFFFFF" />
                  <Setter TargetName="switchThumb" Property="Margin" Value="22,0,0,0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListItemCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      </Style>
      <Style x:Key="PanelItemIconBlock" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
      </Style>
      <Style x:Key="PanelActionButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PanelEmptyHint" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="28,36" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </Style>
      <Style x:Key="ToolboxToolCard" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="158" />
        <Setter Property="Height" Value="124" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="card" Background="{TemplateBinding Control.Background}" CornerRadius="10" Padding="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="card" Property="Border.Background" Value="#FF404040" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Background="#00FFFFFF" Padding="2,3" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="16" Height="16" Margin="0,0,6,0">
                    <Ellipse Name="OuterCircle" Width="16" Height="16" StrokeThickness="1.5" Fill="#00FFFFFF" Stroke="{StaticResource TextMutedBrush}" />
                    <Ellipse Name="InnerCircle" Width="8" Height="8" Opacity="0" Fill="{StaticResource AccentBrush}" />
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="OuterCircle" Property="Shape.Stroke" Value="{StaticResource AccentBrush}" />
                  <Setter TargetName="InnerCircle" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="OuterCircle" Property="Shape.Stroke" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PanelSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid>
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand" Background="{StaticResource AccentBrush}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="{TemplateBinding Control.Background}" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand" Background="{StaticResource BgTertiaryBrush}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="{TemplateBinding Control.Background}" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="16" Height="16" Cursor="Hand">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Ellipse Stroke="#FFFFFFFF" StrokeThickness="1" Fill="{StaticResource AccentBrush}" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ColorSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid>
                <Border Height="14" CornerRadius="7" Margin="9,0" VerticalAlignment="Center">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#FFBD2828" Offset="0" />
                      <GradientStop Color="#FFBDBD28" Offset="0.1667" />
                      <GradientStop Color="#FF28BD28" Offset="0.3333" />
                      <GradientStop Color="#FF28BDBD" Offset="0.5" />
                      <GradientStop Color="#FF2828BD" Offset="0.6667" />
                      <GradientStop Color="#FFBD28BD" Offset="0.8333" />
                      <GradientStop Color="#FFBD2828" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Track Name="PART_Track" VerticalAlignment="Center">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Background="#00FFFFFF" Cursor="Hand">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Background="#00FFFFFF" Cursor="Hand">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="18" Height="18" Cursor="Hand">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Ellipse Fill="#FFFFFFFF" Stroke="#FF666666" StrokeThickness="2">
                            <UIElement.Effect>
                              <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.5" />
                            </UIElement.Effect>
                          </Ellipse>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Style="{StaticResource WindowBorder}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="12,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="16,20,16,12">
            <TextBlock Text="桌面工具箱" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="图标收纳 · 桌面待办" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <Button Name="BtnZones" Style="{StaticResource SidebarButton}" Tag="Zones" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/zones.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="收纳区管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnTodos" Style="{StaticResource SidebarButton}" Tag="Todos" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/todos.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="待办区管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnMappings" Style="{StaticResource SidebarButton}" Tag="Mappings" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/mappings.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="映射区管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnToolbox" Style="{StaticResource SidebarButton}" Tag="Toolbox" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/toolbox.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="工具箱" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Separator Margin="18,10,18,10" Background="{StaticResource BorderBrush}" Height="1" />
            <Button Name="BtnSettings" Style="{StaticResource SidebarButton}" Tag="Settings" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/settings.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="系统设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnBackup" Style="{StaticResource SidebarButton}" Tag="Backup" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/backup.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="备份恢复" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnAbout" Style="{StaticResource SidebarButton}" Tag="About" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/Nav/about.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="关于软件" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Separator Margin="18,10,18,10" Background="{StaticResource BorderBrush}" Height="1" />
            <Border Padding="18,8,14,8" Margin="8,0,8,0">
              <CheckBox Name="ChkAutoStart" Style="{StaticResource ToggleSwitch}" Content="开机自动启动" Click="ChkAutoStart_Click" />
            </Border>
            <Border Padding="18,8,14,8" Margin="8,0,8,0">
              <StackPanel>
                <CheckBox Name="ChkTempShowHidden" Style="{StaticResource ToggleSwitch}" Content="显示隐藏文件" Click="ChkTempShowHidden_Click" />
                <TextBlock Text="仅用于临时查看桌面隐藏文件" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4" LineHeight="16" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />
      <Grid Column="2" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,18,20,12">
          <Grid>
            <TextBlock Name="TxtPageTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Button Name="BtnClosePanel" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Width="32" Height="32" Click="CloseMainPanel_Click">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="border" Background="#28FFFFFF" CornerRadius="6">
                    <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="border" Property="Border.Background" Value="#44FF6666" />
                      <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer Name="ZonesContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Visible" Padding="20,0,20,20">
          <StackPanel>
            <ItemsControl Name="ZonesList" ItemsSource="{Binding Zones}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ListItemCard}" MouseLeftButtonDown="ZoneItem_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Style="{StaticResource PanelItemIconBlock}">
                        <Image Source="pack://application:,,,/Images/Nav/zones.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="共 {0} 个图标 · 收纳区">
                              <Binding Path="TotalIconCount" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PanelActionButton}" Margin="0,0,8,0" Tag="{Binding}" Click="ResetZonePosition_Click">
                          <TextBlock Text="重置位置" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource PanelActionButton}" Background="#E54848" Margin="0,0,8,0" Tag="{Binding}" Click="DismissZoneFromList_Click">
                          <TextBlock Text="解散区域" FontSize="11" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Name="ZonesEmptyHint" Style="{StaticResource PanelEmptyHint}" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="还没有收纳区" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="点击右下角按钮创建第一个收纳区" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource PrimaryButton}" Content="📂  新建收纳区" HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding CreateZoneCommand}" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="TodosContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,0,20,20">
          <StackPanel>
            <Border Style="{StaticResource ListItemCard}" MouseLeftButtonDown="TodoItem_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelItemIconBlock}">
                  <Image Source="pack://application:,,,/Images/Nav/todos.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="桌面待办" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="共 {0} 项任务 · 待办区">
                        <Binding Path="TodoItems.Count" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource PanelActionButton}" Margin="0,0,8,0" Click="OpenRecurringTasks_Click">
                    <TextBlock Text="循环任务" FontSize="11" />
                  </Button>
                  <Button Style="{StaticResource PanelActionButton}" Margin="0,0,8,0" Tag="{Binding}" Click="ResetTodoPosition_Click">
                    <TextBlock Text="重置位置" FontSize="11" />
                  </Button>
                  <Button Style="{StaticResource PanelActionButton}" Background="#FF5C8A5E" Click="RestoreTodoWindow_Click">
                    <TextBlock Text="恢复显示" FontSize="11" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Button Style="{StaticResource PrimaryButton}" Content="📋  新建待办区" HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding CreateTodoCommand}" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="MappingsContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,0,20,20">
          <StackPanel>
            <ItemsControl Name="MappingsList" ItemsSource="{Binding Mappings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ListItemCard}" MouseLeftButtonDown="MappingItem_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Style="{StaticResource PanelItemIconBlock}">
                        <Image Source="pack://application:,,,/Images/Nav/mappings.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="共 {0} 个文件 · 映射区">
                              <Binding Path="TotalFileCount" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Opacity="0.7" Text="{Binding FolderPath}" Visibility="{Binding FolderPath, Converter={StaticResource StringIsNotEmptyToVisibility}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PanelActionButton}" Margin="0,0,8,0" Tag="{Binding}" Click="ResetMappingPosition_Click">
                          <TextBlock Text="重置位置" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource PanelActionButton}" Background="#E54848" Margin="0,0,8,0" Tag="{Binding}" Click="DismissMappingFromList_Click">
                          <TextBlock Text="解散区域" FontSize="11" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Name="MappingsEmptyHint" Style="{StaticResource PanelEmptyHint}" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔗" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="还没有映射区" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="点击右下角按钮创建第一个映射区" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource PrimaryButton}" Content="🔗  新建映射区" HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding CreateMappingCommand}" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="SettingsContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,2,20,20">
          <StackPanel>
            <TextBlock Text="样式调整" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Name="OpacityLabel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="20%" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="OpacitySlider" Grid.Column="1" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid>
                              <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                  <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand" Background="{StaticResource AccentBrush}">
                                    <Control.Template>
                                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Control.Background}" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />
                                      </ControlTemplate>
                                    </Control.Template>
                                  </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                  <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand" Background="{StaticResource BgTertiaryBrush}">
                                    <Control.Template>
                                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Control.Background}" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />
                                      </ControlTemplate>
                                    </Control.Template>
                                  </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                  <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Control.Template>
                                      <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Ellipse Stroke="#FFFFFFFF" StrokeThickness="1" Fill="{StaticResource AccentBrush}" />
                                      </ControlTemplate>
                                    </Control.Template>
                                  </Thumb>
                                </Track.Thumb>
                              </Track>
                            </Grid>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </Slider>
              <TextBlock Grid.Column="2" Text="100%" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="图标间距" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,12,0,4" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="10%" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="IconSpacingSlider" Grid.Column="1" Style="{StaticResource PanelSliderStyle}" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="12,0" VerticalAlignment="Center" ValueChanged="IconSpacingSlider_ValueChanged" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" />
              <TextBlock Name="IconSpacingLabel" Grid.Column="2" Text="30%" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="面板颜色" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,14,0,4" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Name="PanelColorSlider" Grid.Column="0" Minimum="0" Maximum="360" IsSnapToTickEnabled="False" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center" ValueChanged="PanelColorSlider_ValueChanged" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" />
              <Button Name="PanelColorResetButton" Grid.Column="1" Content="重置颜色" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Cursor="Hand" FontSize="12" Background="{StaticResource AccentBrush}" Foreground="#FFFFFFFF" BorderThickness="0" Click="PanelColorResetButton_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
              <Border Name="PanelColorPreview" Width="28" Height="20" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" />
              <TextBlock Name="PanelColorHex" Text="#FF1A1A1A" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
              <TextBox Name="PanelColorInput" Width="84" Margin="12,0,0,0" Background="#FF1C1C1C" Foreground="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2" FontSize="12" VerticalAlignment="Center" ToolTip="输入十六进制颜色值（如 #FF1A1A1A 或 1A1A1A），回车或失焦生效" KeyDown="PanelColorInput_KeyDown" LostFocus="PanelColorInput_LostFocus" />
            </StackPanel>
            <Separator Margin="0,6,0,14" Background="{StaticResource BorderBrush}" />
            <Border Visibility="Visible">
              <StackPanel>
                <TextBlock Text="窗口风格" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
                <TextBlock Text="选择收纳区和待办区窗口的视觉效果。切换后需重新打开对应窗口才能生效。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,16">
                  <TextBlock Text="视觉风格：" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <RadioButton Name="RbStyleSimple" Content="简约透明（默认）" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" GroupName="WindowStyle" />
                  <RadioButton Name="RbStyleGlass" Content="磨砂玻璃" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" GroupName="WindowStyle" />
                  <Button Content="保存并重载" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="12,6" Margin="20,0,0,0" VerticalAlignment="Center" Click="WindowStyleReload_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Separator Margin="0,6,0,14" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="字体大小" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Text="调整收纳区/待办区的文字和图标显示尺寸，适用于高分辨率或大屏显示器。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,16">
              <TextBlock Text="字号级别：" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
              <RadioButton Name="RbFontSmall" Content="小" Tag="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" GroupName="FontSize" Click="FontSizeRadio_Click" />
              <RadioButton Name="RbFontMedium" Content="中（默认）" Tag="1" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" GroupName="FontSize" Click="FontSizeRadio_Click" />
              <RadioButton Name="RbFontLarge" Content="大" Tag="2" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" GroupName="FontSize" Click="FontSizeRadio_Click" />
              <RadioButton Name="RbFontXLarge" Content="特大" Tag="3" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" GroupName="FontSize" Click="FontSizeRadio_Click" />
            </StackPanel>
            <Separator Margin="0,6,0,14" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="已完成待办文字样式" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Text="设置已完成待办的文字显示样式。选择「删除线」后将不再改变文字颜色。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
              <RadioButton Name="RbTodoFaded" GroupName="CompletedTodoStyle" Content="颜色变浅（默认）" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,30,0" Checked="CompletedTodoStyle_Checked" />
              <RadioButton Name="RbTodoStrikethrough" GroupName="CompletedTodoStyle" Content="删除线" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Checked="CompletedTodoStyle_Checked" />
            </StackPanel>
            <Separator Margin="0,6,0,14" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="全局快捷键" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Text="按下快捷键可快速将应用窗体显示到桌面。默认快捷键与 Win+D 相关，易于记忆。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="当前快捷键：" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Name="TxtHotkeyDisplay" Grid.Column="1" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Name="BtnChangeHotkey" Grid.Column="2" Content="修改快捷键" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgHoverBrush}" FontSize="12" BorderThickness="0" Cursor="Hand" Padding="12,6" Margin="0,0,6,0" VerticalAlignment="Center" Click="BtnChangeHotkey_Click">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Button Name="BtnResetHotkey" Grid.Column="3" Content="重置" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgHoverBrush}" FontSize="12" BorderThickness="0" Cursor="Hand" Padding="12,6" VerticalAlignment="Center" Click="BtnResetHotkey_Click">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </Grid>
            </Border>
            <Separator Margin="0,6,0,14" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="收纳模式" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">选择图标的隐藏方式。切换模式会将所有已收纳的图标迁移到新模式。</TextBlock>
            <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
              <StackPanel>
                <RadioButton Name="RbModeAttribute" GroupName="HidingModeMain" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,4" Checked="HidingMode_Checked">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="属性隐藏（视觉收纳）" VerticalAlignment="Center" />
                    <Border Background="#FF2A8A3A" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                      <TextBlock Text="推荐" FontSize="9" Foreground="#FFE0FFE0" VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </RadioButton>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,6" LineHeight="16">文件保留在桌面原始位置，通过设置「隐藏+系统」属性使之不可见。零数据丢失风险，恢复速度极快。</TextBlock>
                <RadioButton Name="RbModePhysical" Content="路径隐藏（物理收纳）" GroupName="HidingModeMain" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,6,0,4" Checked="HidingMode_Checked" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,0" LineHeight="16">文件被移动到隐藏目录（AppData\Local\DesktopTool\hidden）。退出软件时自动恢复。注意：物理移动存在跨盘拷贝的数据风险。</TextBlock>
              </StackPanel>
            </Border>
            <Button Name="SwitchModeButton" Content="切换收纳模式" Foreground="#FFFFFFFF" Background="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Height="38" Cursor="Hand" BorderThickness="0" Margin="0,0,0,6" IsEnabled="False" Click="SwitchModeButton_Click">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="16,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsEnabled" Value="False">
                      <Setter Property="Control.Background" Value="#FF505866" />
                      <Setter Property="Control.Foreground" Value="#FF888888" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Value="{StaticResource AccentHoverBrush}" Property="Control.Background" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
            <TextBlock Text="隐藏文件存储路径" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Name="CurrentHiddenPathText" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="WrapWithOverflow" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" Cursor="Hand" TextDecorations="Underline" ToolTip="点击在资源管理器中打开该目录" MouseLeftButtonDown="CurrentPath_Click" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Name="CustomPathTextBox" Grid.Column="0" Background="{StaticResource BgTertiaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="#FFFFFFFF" BorderThickness="0" FontSize="12" Padding="10,7" VerticalAlignment="Center" ToolTip="留空则使用默认路径">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                      <Setter Property="Border.CornerRadius" Value="4" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </TextBox>
              <Button Grid.Column="1" Content="浏览..." Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgHoverBrush}" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="6,0,4,0" Padding="10,5" Click="BrowsePath_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="8,3">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <Button Grid.Column="2" Content="保存" Foreground="#FFFFFFFF" Background="{StaticResource AccentBrush}" FontSize="12" BorderThickness="0" Cursor="Hand" Padding="14,5" Click="SaveHiddenPath_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="18,0">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </Grid>
            <TextBlock Foreground="#FFE8A857" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap">⚠ 请勿手动删除、重命名或修改隐藏目录及内容，否则可能导致文件丢失。</TextBlock>
            <Separator Margin="0,16,0,12" Background="{StaticResource BorderBrush}" Opacity="0.5" />
            <TextBlock Text="数据复原" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">将收纳区内所有已隐藏/移动的图标全部还原到桌面上显示，并清空所有收纳区内容。<LineBreak />此操作不可撤销，请在操作前确认无误。</TextBlock>
            <Button Name="BtnRestoreAll" Content="一键复原文件" Foreground="#FFFFFFFF" Background="#FFE88D3C" FontSize="14" FontWeight="SemiBold" Height="42" Cursor="Hand" BorderThickness="0" Margin="0,4,0,0" Click="RestoreAllButton_Click">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="24,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="ToolboxContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,0,20,20">
          <StackPanel>
            <TextBlock Text="集合各类实用小工具，点击图标即可使用。后续将持续扩展更多工具。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
            <ItemsControl Name="ToolboxList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ToolboxToolCard}" Tag="{Binding Id}" Click="ToolboxTool_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IconContainerless}">
                                <Setter Property="Background" Value="#00FFFFFF" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <Grid>
                          <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="#00FFFFFF" Width="30" Height="30" Stretch="Uniform" Data="{Binding IconPath}" Visibility="{Binding IconImage, Converter={StaticResource StringIsEmptyToVisibility}}" />
                          <TextBlock FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}" Visibility="{Binding IconPath, Converter={StaticResource StringIsEmptyToVisibility}}" />
                          <Image Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding IconImage}" Visibility="{Binding IconImage, Converter={StaticResource StringIsNotEmptyToVisibility}}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Image}">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="30" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding IconContainerless}">
                                    <Setter Property="Width" Value="52" />
                                    <Setter Property="Height" Value="52" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Image>
                        </Grid>
                      </Border>
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Text="{Binding Name}" />
                      <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="140" Margin="0,3,0,0" Text="{Binding Description}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="AboutContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,2,20,20">
          <StackPanel>
            <Border Width="56" Height="56" Margin="0,6,0,8" HorizontalAlignment="Center">
              <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/applogo.png" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
              <TextBlock Text="桌面工具箱" FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0078D4" Offset="0" />
                    <GradientStop Color="#FF1A86DB" Offset="1" />
                  </LinearGradientBrush>
                </TextBlock.Foreground>
              </TextBlock>
              <TextBlock Name="AboutVersionText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Name="AboutUpdatePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <TextBlock Name="AboutUpdateLabel" Text="官网更新：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <Button Content="点击查看" Foreground="{StaticResource AccentBrush}" FontSize="12" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Padding="0" Click="AboutUpdateLink_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <TextBlock Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" TextDecorations="Underline" Cursor="Hand" />
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </StackPanel>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="40,6,40,10" />
            <Border Background="{StaticResource AccentLightBrush}" CornerRadius="6" Margin="0,0,0,10" Padding="14,10">
              <StackPanel>
                <TextBlock Text="软件声明" FontSize="12" FontWeight="SemiBold" Foreground="#FFE8A857" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18">本软件为免费软件，任何组织或个人未经作者授权，不得将本软件或其衍生品用于任何商业盈利目的。违者必究。</TextBlock>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="6" Margin="0,0,0,10" Padding="14,10">
              <StackPanel>
                <TextBlock Text="联系作者" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="QQ 群 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                  <TextBox Text="1063128773" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="#00FFFFFF" Padding="0" Margin="0,0,16,0" Cursor="IBeam" VerticalAlignment="Center" ToolTip="点击选中，Ctrl+C 复制" FocusVisualStyle="{x:Null}" GotFocus="CopyableTextBox_GotFocus" />
                  <TextBlock Text="微信 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                  <TextBox Text="conanmiaoai" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="#00FFFFFF" Padding="0" Margin="0,0,16,0" Cursor="IBeam" VerticalAlignment="Center" ToolTip="点击选中，Ctrl+C 复制" FocusVisualStyle="{x:Null}" GotFocus="CopyableTextBox_GotFocus" />
                  <TextBlock Text="抖音 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                  <TextBox Text="古法编程哥" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="#00FFFFFF" Padding="0" Cursor="IBeam" VerticalAlignment="Center" ToolTip="点击选中，Ctrl+C 复制" FocusVisualStyle="{x:Null}" GotFocus="CopyableTextBox_GotFocus" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Name="AboutDonateSeparator" Height="1" Background="{StaticResource BorderBrush}" Margin="40,0,40,10" />
            <StackPanel Name="AboutDonatePanel" Margin="0,0,0,0" HorizontalAlignment="Center">
              <TextBlock Text="作者正在为爱发电" FontSize="13" FontWeight="SemiBold" Foreground="#FFE8A857" HorizontalAlignment="Center" Margin="0,0,0,6" />
              <TextBlock Text="如果你觉得这个小工具对你有帮助，" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="可以请作者喝杯奶茶吗，鞠躬~~" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <Button Content="来 一 杯" Width="120" Height="36" FontSize="14" Foreground="#FFFFFFFF" Background="#FFE07C3E" BorderThickness="0" Cursor="Hand" Click="AboutDonate_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" CornerRadius="16" Padding="20,0">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Control.Background" Value="#FFF0913D" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="BackupContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,2,20,20">
          <StackPanel Margin="0,8,0,0">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0">创建配置备份，在误删收纳区/待办或配置错乱后可一键还原。 恢复后软件会自动重启以应用结果。</TextBlock>
              <Button Name="BtnCreateBackup" Grid.Column="1" Content="新建备份" Style="{StaticResource PrimaryButton}" MinWidth="100" Height="34" VerticalAlignment="Center" Click="BtnCreateBackup_Click" />
            </Grid>
            <TextBlock Name="TxtBackupHint" Margin="0,0,0,16" FontSize="12" Foreground="#FFE07C3E" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Text="已有备份" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
            <ItemsControl Name="BackupList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Details}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                          <Run Text="软件版本 " />
                          <Run Text="{Binding AppVersion}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="恢复" MinWidth="48" Height="26" FontSize="12" Margin="0,0,6,0" Style="{StaticResource AccentFillButton}" Click="BtnRestoreBackup_Click" />
                        <Button Content="删除" MinWidth="48" Height="26" FontSize="12" Style="{StaticResource DangerFillButton}" Click="BtnDeleteBackup_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="TxtBackupEmpty" Text="暂无备份，点击右上角「新建备份」创建第一个配置备份。" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>