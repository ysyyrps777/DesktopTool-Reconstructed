        <Button Grid.Column="1" Content="＋" Background="{StaticResource Sb_1A_FFFFFF}" Foreground="#FFFFFFFF" BorderThickness="0" FontWeight="Bold" Width="36" Height="36" Margin="8,0,0,0" Cursor="Hand" Command="{Binding AddTodoCommand}" FontSize="{Binding TodoLargeFontSize}">
          <Control.Template>
