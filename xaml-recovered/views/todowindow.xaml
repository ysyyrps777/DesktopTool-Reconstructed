              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{StaticResource Sb_66_FFFFFF}" Property="Control.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </Grid>
      <Grid Row="2" Margin="0,8,0,0" Visibility="{Binding ContentVisibility}">
