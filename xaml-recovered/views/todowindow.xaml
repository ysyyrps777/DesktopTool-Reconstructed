          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="{StaticResource Sb_66_FFFFFF}" FontSize="16" VerticalAlignment="Center" Margin="6,0,2,0" Cursor="SizeAll" ToolTip="拖拽移动待办区" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
