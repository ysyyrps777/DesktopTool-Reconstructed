        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4,2" />
