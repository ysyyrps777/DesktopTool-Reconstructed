          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#FF3A3A44" BorderBrush="#FF555565" BorderThickness="1" CornerRadius="4" Padding="6,4" MinWidth="120">
              <TextBlock Name="TxtReminderDate" Foreground="#FFFFFFFF" FontSize="13" Text="-" VerticalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource ZoneButtonStyle}" Margin="8,0,0,0" Click="ReminderPicker_PickDate">📅 选择日期</Button>
          </StackPanel>
          <TextBlock Text="时间" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,2" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBox Name="TxtReminderTime" Width="120" Height="34" Foreground="#FFFFFFFF" FontSize="15" Background="#FF3A3A44" BorderBrush="#FF555565" BorderThickness="1" Padding="8,2" VerticalContentAlignment="Center" ToolTip="格式 时:分，例如 09:30，可直接键盘输入" TextChanged="TxtReminderTime_TextChanged" />
            <TextBlock Text="（时:分，可直接输入）" Foreground="#FFCCCCCC" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox Name="LstReminderHour" Grid.Column="0" Height="130" Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource DarkListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="LstReminderHour_SelectionChanged">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource NarrowScrollBar}" />
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ListBox>
            <TextBlock Grid.Column="1" Text="时" Foreground="#FFCCCCCC" FontSize="13" VerticalAlignment="Center" Margin="8,0" />
            <ListBox Name="LstReminderMinute" Grid.Column="2" Height="130" Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource DarkListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="LstReminderMinute_SelectionChanged">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource NarrowScrollBar}" />
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ListBox>
            <TextBlock Grid.Column="3" Text="分" Foreground="#FFCCCCCC" FontSize="13" VerticalAlignment="Center" Margin="8,0" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="今天" Style="{StaticResource ZoneButtonStyle}" Width="64" Margin="3" Click="ReminderPicker_Today" />
            <Button Content="明天" Style="{StaticResource ZoneButtonStyle}" Width="64" Margin="3" Click="ReminderPicker_Tomorrow" />
            <Button Content="清除提醒" Style="{StaticResource ZoneButtonStyle}" Width="72" Margin="3" Click="ReminderPicker_Clear" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource ZoneButtonStyle}" Width="70" Margin="4" Click="ReminderPicker_OK" />
            <Button Content="取消" Style="{StaticResource ZoneButtonStyle}" Width="70" Margin="4" Click="ReminderPicker_Cancel" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Canvas Name="DragOverlay" IsHitTestVisible="False" ZIndex="999" />
  </Grid>
</Window>