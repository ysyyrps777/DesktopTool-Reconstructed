<Window x:Class="DesktopTool.Views.TodoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:DesktopTool.Converters" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ResizeMode="NoResize" SnapsToDevicePixels="True" UseLayoutRounding="True" Title="待办" MinWidth="200" MinHeight="50" MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}" xmlns:views="clr-namespace:DesktopTool.Views">
