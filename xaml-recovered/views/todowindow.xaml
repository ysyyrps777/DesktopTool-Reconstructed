              <Path Width="14" Height="14" Stretch="Uniform" Data="{Binding LockIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Content="📤" Style="{StaticResource ZoneButtonStyle}" ToolTip="导出待办" FontSize="12" Margin="0,0,4,0" Click="ExportMenuButton_Click">
              <FrameworkElement.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="📊 导出到 Excel（含日期/状态）" Command="{Binding ExportToExcelCommand}" />
                  <MenuItem Header="📄 导出到 TXT（仅内容文本）" Command="{Binding ExportToTxtCommand}" />
                </ContextMenu>
              </FrameworkElement.ContextMenu>
            </Button>
            <Button Content="✕" Style="{StaticResource ZoneButtonStyle}" FontSize="14" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="1" Margin="0,8,0,0" Visibility="{Binding ContentVisibility}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <TextBlock Name="PlaceholderText" Text="输入新的待办事项..." Foreground="{StaticResource Sb_66_FFFFFF}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="14,0,0,0" FontSize="{Binding TodoContentFontSize}" />
          <TextBox Name="TodoInputBox" Background="{StaticResource Sb_1A_FFFFFF}" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" BorderThickness="0" Padding="10,8" VerticalAlignment="Top" VerticalContentAlignment="Top" MinHeight="36" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" InputMethod.IsInputMethodEnabled="True" Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}" FontSize="{Binding TodoContentFontSize}" PreviewMouseLeftButtonDown="TodoInput_PreviewMouseLeftButtonDown" LostKeyboardFocus="TodoInput_LostKeyboardFocus" GotFocus="TodoInput_GotFocus" PreviewKeyDown="TodoInput_PreviewKeyDown" TextChanged="TodoInput_TextChanged">
