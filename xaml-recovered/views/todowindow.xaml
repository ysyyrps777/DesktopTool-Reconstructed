      <Style x:Key="DarkCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFE0E0E0" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CalendarDayButton}">
              <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="CalendarDayButton.IsToday" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="#FF5A9EFF" />
                </Trigger>
                <Trigger Property="CalendarDayButton.IsSelected" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="#FF3370C0" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Sb_33_FFFFFF}" />
                </Trigger>
                <Trigger Property="CalendarDayButton.IsBlackedOut" Value="True">
                  <Setter Property="Foreground" Value="#FF444444" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DarkCalendarButton" TargetType="{x:Type CalendarButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFE0E0E0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CalendarButton}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="6,4" MinWidth="28" MinHeight="28">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource Sb_33_FFFFFF}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DarkCalendarItem" TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFE0E0E0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CalendarItem}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Name="PART_PreviousButton" Grid.Column="0" Content="◀" Foreground="#FF999999" FontSize="10" Style="{StaticResource DarkCalendarButton}" />
                    <Button Name="PART_HeaderButton" Grid.Column="1" Content="2026年6月" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" Style="{StaticResource DarkCalendarButton}" />
                    <Button Name="PART_NextButton" Grid.Column="2" Content="▶" Foreground="#FF999999" FontSize="10" Style="{StaticResource DarkCalendarButton}" />
                  </Grid>
                  <Grid Name="PART_DayNames" Row="1" Margin="0,4,0,2" />
                  <Grid Name="PART_MonthView" Row="2" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TodoPickerPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FF2C2C34" />
        <Setter Property="BorderBrush" Value="#FF555565" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="14,12" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="NarrowScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Sb_44_FFFFFF}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" Width="{TemplateBinding FrameworkElement.Width}">
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border CornerRadius="3" Margin="1,0" Background="{StaticResource Sb_55_FFFFFF}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{StaticResource Sb_44_FFFFFF}" />
                                <Style.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Sb_77_FFFFFF}" />
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Border>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="#FF2B2B2B" />
        <Setter Property="Foreground" Value="#FFF3F3F3" />
        <Setter Property="BorderBrush" Value="#FF3B3B3B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="13" />
