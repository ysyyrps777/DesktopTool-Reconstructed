<Window x:Class="DesktopTool.Views.DonationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="打赏作者" Width="440" Height="580" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF2E3238" WindowStyle="None" AllowsTransparency="True" xmlns:views="clr-namespace:DesktopTool.Views;assembly=DesktopTool">
  <Border BorderBrush="#FF4A5568" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#FF1E2228">
        <TextBlock Text="☕ 打赏作者" Foreground="#FFE0E0E0" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Content="✕" FontSize="11" Foreground="#FFF5F5F5" Background="#FFC0392B" Width="26" Height="22" HorizontalAlignment="Right" Margin="0,0,8,0" Cursor="Hand" Padding="0" BorderThickness="0" Click="CloseButton_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </Grid>
      <Grid Row="1" Margin="24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
          <Button Name="TabWechat" Content="💚 微信支付" Padding="18,8" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" Background="#FF07C160" BorderThickness="0" Cursor="Hand" Click="TabWechat_Click">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="8,0,0,8" Padding="{TemplateBinding Control.Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Border.Background" Value="#FF08B857" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
          <Button Name="TabAlipay" Content="💙 支付宝" Padding="18,8" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" Background="#FF505866" BorderThickness="0" Cursor="Hand" Click="TabAlipay_Click">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="0,8,8,0" Padding="{TemplateBinding Control.Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Border.Background" Value="#FF5C6574" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
          <TextBlock Text="作者：苗培壮" FontSize="15" FontWeight="SemiBold" Foreground="#FFE8A857" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Text="感谢你的支持！🙏" FontSize="14" FontWeight="SemiBold" Foreground="#FFD4AF37" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <Border Name="WechatPanel" Background="#FFFFFFFF" CornerRadius="10" ClipToBounds="True" Padding="16">
            <Image Source="pack://application:,,,/donate_qrcode.png" Stretch="Uniform" MaxWidth="300" MaxHeight="300" />
          </Border>
          <Border Name="AlipayPanel" Background="#FFFFFFFF" CornerRadius="10" ClipToBounds="True" Padding="16" Visibility="Collapsed">
            <Image Source="pack://application:,,,/donate_alipay.png" Stretch="Uniform" MaxWidth="300" MaxHeight="300" />
          </Border>
          <TextBlock Name="TipText" Text="使用微信扫码，任意金额均可~" FontSize="12" Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>