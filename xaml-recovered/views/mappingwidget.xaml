<UserControl x:Class="DesktopTool.Views.MappingWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:DesktopTool.Converters" xmlns:local="clr-namespace:DesktopTool" Background="#00FFFFFF" MinWidth="200" MinHeight="52" SnapsToDevicePixels="True" UseLayoutRounding="True" xmlns:views="clr-namespace:DesktopTool.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibility" />
      <converters:IsDirectoryToStretchConverter x:Key="IsDirectoryToStretch" />
      <converters:StringIsEmptyToVisibilityConverter x:Key="StringIsEmptyToVisibilityConverter" />
      <Style x:Key="ZoneButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" MinHeight="{TemplateBinding FrameworkElement.MinHeight}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#33FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ZoneMenuButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ZoneButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style x:Key="ZoneMenuOptionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ZoneButtonStyle}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="ZoneMenuDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ZoneMenuButtonStyle}">
        <Setter Property="Foreground" Value="#FF6B6B" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </Style>
      <Style x:Key="NarrowScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" Width="{TemplateBinding FrameworkElement.Width}">
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border Background="#55FFFFFF" CornerRadius="3" Margin="1,0" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootGrid" MouseEnter="RootGrid_MouseEnter" MouseLeave="RootGrid_MouseLeave">
    <Border CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Background="{Binding PanelColorBrush}" Opacity="{Binding BackgroundOpacity}" />
    <Canvas Name="DragOverlay" IsHitTestVisible="False" ZIndex="1000" />
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Height="36" Cursor="SizeAll" ToolTip="拖拽移动映射区" PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="#66FFFFFF" FontSize="16" VerticalAlignment="Center" Margin="6,0,2,0" Cursor="SizeAll" ToolTip="拖拽移动映射区" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
          <TextBox Name="TitleTextBox" Grid.Column="1" FontSize="14" FontWeight="SemiBold" BorderThickness="0" VerticalAlignment="Center" Margin="10,0" InputMethod.IsInputMethodEnabled="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}" PreviewMouseLeftButtonDown="TitleTextBox_PreviewMouseLeftButtonDown" LostKeyboardFocus="TitleTextBox_LostKeyboardFocus" KeyDown="TitleTextBox_KeyDown">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="TextBoxBase.CaretBrush" Value="#FFFFFFFF" />
                <Setter Property="TextBoxBase.SelectionBrush" Value="#66FFFFFF" />
                <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                <Style.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="UIElement.IsKeyboardFocusWithin" Value="True" />
                      <Condition Property="TextBoxBase.IsReadOnly" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFFFFF" />
                    <Setter Property="Foreground" Value="#FF1A1A1A" />
                    <Setter Property="TextBoxBase.CaretBrush" Value="#FF1A1A1A" />
                    <Setter Property="TextBoxBase.SelectionBrush" Value="#CC4A90D9" />
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="FrameworkElement.Cursor" Value="IBeam" />
                  </MultiTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBox>
          <StackPanel Name="TitleButtonsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
            <Grid Width="84" Height="26" Margin="0,0,6,0" VerticalAlignment="Center">
              <Border Background="#1AFFFFFF" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" />
              <TextBox Name="MappingSearchBox" Background="#00FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="12" VerticalContentAlignment="Center" Padding="6,0" Margin="1" InputMethod.IsInputMethodEnabled="True" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="MappingSearch_PreviewMouseLeftButtonDown" GotFocus="MappingSearch_GotFocus" LostKeyboardFocus="MappingSearch_LostKeyboardFocus" />
              <TextBlock Text="搜索文件…" IsHitTestVisible="False" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding Text, ElementName=MappingSearchBox, Converter={StaticResource StringIsEmptyToVisibilityConverter}}" />
            </Grid>
            <Button Style="{StaticResource ZoneButtonStyle}" ToolTip="折叠/展开" FontSize="11" Margin="0,0,4,0" Content="{Binding CollapseLabel}" Command="{Binding ToggleCollapseCommand}" />
            <Button Name="MoreButton" Style="{StaticResource ZoneButtonStyle}" ToolTip="更多操作" FontSize="14" Margin="0,0,4,0" Content="☰" Click="MoreButton_Click" />
            <Popup Name="MorePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" PlacementTarget="{Binding ElementName=MoreButton}" Closed="MorePopup_Closed">
              <Border Background="#262626" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="6" Width="184">
                <StackPanel>
                  <Button Style="{StaticResource ZoneMenuButtonStyle}" Command="{Binding ToggleLockCommand}" Click="MoreMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                      <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" Data="{Binding LockIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="{Binding LockMenuLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource ZoneMenuButtonStyle}" Command="{Binding RefreshCommand}" Click="MoreMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M12,4 L12,1 L8,5 L12,9 L12,6 C15.31,6 18,8.69 18,12 C18,13.01 17.75,13.97 17.3,14.8 L18.76,16.26 A7.93,7.93 0 0 0 20,12C20,7.58 16.42,4 12,4 M12,18 C8.69,18 6,15.31 6,12 C6,10.99 6.25,10.03 6.7,9.2 L5.24,7.74 A7.93,7.93 0 0 0 4,12C4,16.42 7.58,20 12,20 L12,23 L16,19 L12,15 L12,18" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="刷新" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="图标尺寸" Foreground="#BBB" FontSize="11" Margin="2,8,0,4" />
                  <StackPanel Orientation="Horizontal">
                    <Button CommandParameter="3" Content="列表" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetIconSizeCommand}" Background="{Binding IconSizeLevel, ConverterParameter=3, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="0" Content="小" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetIconSizeCommand}" Background="{Binding IconSizeLevel, ConverterParameter=0, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="1" Content="中" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetIconSizeCommand}" Background="{Binding IconSizeLevel, ConverterParameter=1, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="2" Content="大" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetIconSizeCommand}" Background="{Binding IconSizeLevel, ConverterParameter=2, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                  </StackPanel>
                  <TextBlock Text="排序方式" Foreground="#BBB" FontSize="11" Margin="2,8,0,4" />
                  <StackPanel Orientation="Horizontal">
                    <Button CommandParameter="0" Content="名称" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortModeCommand}" Background="{Binding IconSortMode, ConverterParameter=0, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="1" Content="日期" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortModeCommand}" Background="{Binding IconSortMode, ConverterParameter=1, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="2" Content="类型" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortModeCommand}" Background="{Binding IconSortMode, ConverterParameter=2, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="3" Content="大小" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortModeCommand}" Background="{Binding IconSortMode, ConverterParameter=3, Converter={converters:IntEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                  </StackPanel>
                  <TextBlock Text="排序方向" Foreground="#BBB" FontSize="11" Margin="2,8,0,4" />
                  <StackPanel Orientation="Horizontal">
                    <Button CommandParameter="true" Content="递增" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortDirectionCommand}" Background="{Binding IconSortAscendingHighlight, ConverterParameter=true, Converter={converters:BoolEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button CommandParameter="false" Content="递减" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortDirectionCommand}" Background="{Binding IconSortDescendingHighlight, ConverterParameter=true, Converter={converters:BoolEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                    <Button Content="原路径" Style="{StaticResource ZoneMenuOptionStyle}" Command="{Binding SetSortUseFolderCommand}" Background="{Binding IconSortUseFolder, ConverterParameter=true, Converter={converters:BoolEqualsToBrushConverter}}" Click="MoreMenuItem_Click" />
                  </StackPanel>
                  <Separator Margin="0,8,0,0" Background="#444" />
                  <Button Content="解散映射区" Style="{StaticResource ZoneMenuDangerButtonStyle}" Click="DismissButton_Click" />
                </StackPanel>
              </Border>
            </Popup>
            <Button Content="✕" Style="{StaticResource ZoneButtonStyle}" FontSize="14" Visibility="Collapsed" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Margin="0,4,0,0" Background="#00FFFFFF" CornerRadius="6" Padding="4,2" Visibility="{Binding ContentVisibility}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Name="BtnScrollLeft" Content="‹" Style="{StaticResource ZoneButtonStyle}" FontSize="14" Padding="2,0" Visibility="Collapsed" Click="TabScrollLeft_Click" />
          <ScrollViewer Name="TabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel">
            <ItemsControl Name="TabsItemsControl" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Name="TabBorder" Padding="8,4" Cursor="Arrow" CornerRadius="4" Margin="0,0,2,0" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown" PreviewMouseMove="TabItem_PreviewMouseMove" PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp" MouseRightButtonDown="TabItem_RightClick">
                    <FrameworkElement.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="重命名" Click="TabContext_Rename" />
                        <MenuItem Header="删除分组" Click="TabContext_Delete" />
                        <Separator />
                        <MenuItem Header="设置映射路径" Click="TabContext_SetPath" />
                        <MenuItem Header="打开路径" Click="TabContext_OpenPath" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Value="True">
                            <DataTrigger.Binding>
                              <MultiBinding Converter="{converters:MappingTabActiveConverter}">
                                <Binding Path="." />
                                <Binding Path="DataContext.ActiveGroup" RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}" />
                              </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#1AFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <TextBox FontSize="12" BorderThickness="0" VerticalAlignment="Center" IsReadOnly="True" Cursor="Arrow" InputMethod.IsInputMethodEnabled="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MouseLeftButtonDown="TabName_MouseLeftButtonDown" LostKeyboardFocus="TabName_LostKeyboardFocus" KeyDown="TabName_KeyDown">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
                          <Setter Property="Background" Value="#00FFFFFF" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter Property="TextBoxBase.CaretBrush" Value="#FFFFFFFF" />
                          <Setter Property="TextBoxBase.SelectionBrush" Value="#66FFFFFF" />
                          <Style.Triggers>
                            <Trigger Property="TextBoxBase.IsReadOnly" Value="False">
                              <Setter Property="Background" Value="#FFFFFFFF" />
                              <Setter Property="Foreground" Value="#FF1A1A1A" />
                              <Setter Property="TextBoxBase.CaretBrush" Value="#FF1A1A1A" />
                              <Setter Property="TextBoxBase.SelectionBrush" Value="#CC4A90D9" />
                              <Setter Property="FrameworkElement.Cursor" Value="IBeam" />
                              <Setter Property="Padding" Value="6,2" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Name="BtnScrollRight" Grid.Column="2" Content="›" Style="{StaticResource ZoneButtonStyle}" FontSize="14" Padding="2,0" Visibility="Collapsed" Click="TabScrollRight_Click" />
          <Button Grid.Column="3" Content="＋" Style="{StaticResource ZoneButtonStyle}" ToolTip="添加分组" FontSize="12" Padding="4,2" Margin="4,0,0,0" Click="AddGroup_Click" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Visibility="{Binding ContentVisibility}" DragEnter="IconsArea_DragEnter" DragOver="IconsArea_DragOver" Drop="IconsArea_Drop" GiveFeedback="IconsArea_GiveFeedback">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource NarrowScrollBar}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid>
          <ItemsControl Name="FilesItemsControl" ItemsSource="{Binding VisibleFiles}" Visibility="{Binding IsListView, Converter={StaticResource BoolToInverseVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#00FFFFFF" CornerRadius="4" Cursor="Arrow" ToolTip="..." Width="{Binding DataContext.IconContainerWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.IconContainerHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="{Binding DataContext.IconSpacingThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" MouseLeftButtonDown="FileItem_MouseLeftButtonDown" MouseMove="FileItem_MouseMove" MouseLeftButtonUp="FileItem_MouseLeftButtonUp" MouseRightButtonDown="FileItem_MouseRightButtonDown" ToolTipOpening="FileItem_ToolTipOpening" ContextMenuOpening="MappingFileContextMenu_Opening">
                  <FrameworkElement.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="打开" Click="ContextMenu_Open" />
                      <MenuItem Name="MenuRunAsAdminMap1" Header="以管理员身份运行" Visibility="Collapsed" Click="ContextMenu_RunAsAdmin" />
                      <MenuItem Header="打开文件所在位置" Click="ContextMenu_OpenFolder" />
                      <Separator />
                      <MenuItem Header="重命名" Click="ContextMenu_RenameFile" />
                      <MenuItem Header="属性" Click="ContextMenu_Properties" />
                      <Separator />
                      <MenuItem Header="复制" Click="ContextMenu_Copy" />
                      <Separator />
                      <MenuItem Header="删除(回收站)" Click="ContextMenu_Recycle" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <FrameworkElement.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                      <BeginStoryboard>
                        <Storyboard>
                          <ColorAnimation Duration="0:0:0.15" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#28FFFFFF" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                      <BeginStoryboard>
                        <Storyboard>
                          <ColorAnimation Duration="0:0:0.15" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </FrameworkElement.Triggers>
                  <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Image HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconImage}" Width="{Binding DataContext.IconImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.IconImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="{Binding IsDirectory, Converter={StaticResource IsDirectoryToStretch}}" />
                    <TextBlock Foreground="#FFFFFFFF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" local:TwoLineTextHelper.MaxLines="2" FontSize="{Binding DataContext.IconFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxWidth="{Binding DataContext.IconTextWrapWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" local:TwoLineTextHelper.FullText="{Binding DisplayName}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Name="ListItemsControl" ItemsSource="{Binding VisibleFiles}" Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border MinHeight="32" Margin="2,0" CornerRadius="4" Padding="6,1" Cursor="Arrow" ToolTip="..." MouseLeftButtonDown="FileItem_MouseLeftButtonDown" MouseMove="FileItem_MouseMove" MouseLeftButtonUp="FileItem_MouseLeftButtonUp" MouseRightButtonDown="FileItem_MouseRightButtonDown" ToolTipOpening="FileItem_ToolTipOpening" ContextMenuOpening="MappingFileContextMenu_Opening">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#30FFFFFF" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <FrameworkElement.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="打开" Click="ContextMenu_Open" />
                      <MenuItem Name="MenuRunAsAdminMap2" Header="以管理员身份运行" Visibility="Collapsed" Click="ContextMenu_RunAsAdmin" />
                      <MenuItem Header="打开文件所在位置" Click="ContextMenu_OpenFolder" />
                      <Separator />
                      <MenuItem Header="重命名" Click="ContextMenu_RenameFile" />
                      <MenuItem Header="属性" Click="ContextMenu_Properties" />
                      <Separator />
                      <MenuItem Header="复制" Click="ContextMenu_Copy" />
                      <Separator />
                      <MenuItem Header="删除(回收站)" Click="ContextMenu_Recycle" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconImage}" Stretch="{Binding IsDirectory, Converter={StaticResource IsDirectoryToStretch}}" />
                    <TextBlock Grid.Column="1" Foreground="#FFFFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" FontSize="{Binding DataContext.IconFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Grid.Column="2" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding LastWriteTime, StringFormat=yyyy/MM/dd HH:mm}" FontSize="{Binding DataContext.IconFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding DataContext.IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="#00FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" Visibility="{Binding ShowEmptyPrompt}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5" />
              <TextBlock Text="尚未设置映射路径" Foreground="#FF8899AA" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,6" />
              <TextBlock Text="右键点击 Tab 分组名称，选择「设置映射路径」" Foreground="#FF557788" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16" />
              <Button Content="📁 设置映射路径" HorizontalAlignment="Center" Padding="16,8" Cursor="Hand" Command="{Binding SetCurrentGroupPathCommand}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF335588" />
                    <Setter Property="Foreground" Value="#FFCCE0FF" />
                    <Setter Property="BorderBrush" Value="#FF557799" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF4477AA" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>