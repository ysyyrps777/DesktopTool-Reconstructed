<Window x:Class="DesktopTool.Views.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Width="380" Height="170" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#EE1E1E2E" WindowStyle="None" AllowsTransparency="True" BorderBrush="#FF444466" BorderThickness="1" xmlns:views="clr-namespace:DesktopTool.Views;assembly=DesktopTool" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border Background="#EE1E1E2E" CornerRadius="8" Padding="20,16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Name="TitleText" Grid.Row="0" Text="提示" Foreground="#FFE0E0F0" FontSize="14" FontFamily="Microsoft YaHei UI" Margin="0,0,0,10" />
      <TextBlock Name="MessageText" Grid.Row="1" Text="" Foreground="#FFD0D0E0" FontSize="12.5" FontFamily="Microsoft YaHei UI" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Name="YesButton" Content="是" Width="72" Height="30" FontSize="12" Foreground="#FFFFFFFF" Background="#FF4A90D9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="Yes_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="16,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button Name="NoButton" Content="否" Width="72" Height="30" FontSize="12" Foreground="#FFFFFFFF" Background="#FF666666" BorderThickness="0" Cursor="Hand" Click="No_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="16,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>